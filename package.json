{
  "name": "careermetro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/staging-db.mjs && node scripts/wait-for-migrations.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "eval:parse": "vitest run --config vitest.eval.config.ts src/evals/parse.eval.ts",
    "eval:jd": "vitest run --config vitest.eval.config.ts src/evals/jd.eval.ts",
    "eval:explain": "vitest run --config vitest.eval.config.ts src/evals/explain.eval.ts",
    "eval:build": "vitest run --config vitest.eval.config.ts src/evals/build.eval.ts",
    "eval:mock": "vitest run --config vitest.eval.config.ts src/evals/mock.eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-content.mjs",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.15.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
