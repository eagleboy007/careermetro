{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/weekly-email",
      "schedule": "30 2 * * 1-3"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "dependabot/**": false,
      "feature/**": false,
      "fix/**": false,
      "data/**": false
    }
  }
}
