# Copy to .env.local for local development. Never commit real values.
# In production these are set in the Vercel project settings.

# Supabase Postgres, transaction pooler (port 6543), Mumbai region
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Anthropic API key for resume parsing. Server only.
ANTHROPIC_API_KEY=
# Local only: point the app at the stand-in Claude API (`node e2e/mock-ai.mjs`). See docs/local-setup.md.
# ANTHROPIC_BASE_URL=http://127.0.0.1:4011

# Random string (32+ characters). Vercel sends it to the daily cleanup job; also keys the per-IP upload counter.
CRON_SECRET=
# Keys for one-way hashes of resume names, and of IPs and emails in rate limits (H7). Optional locally; without them
# both fall back to CRON_SECRET. Generate each with: openssl rand -base64 32
# NAME_HASH_KEY also keys Corporate's work-email codes and invites, never with CRON_SECRET: in production without it,
# company sign-up and joining are off ("not set up yet"). Never rotate it.
NAME_HASH_KEY=
IP_HASH_KEY=
# Optional key for phone numbers candidates share for an interview (encrypted, not hashed). Without it NAME_HASH_KEY is
# used; in production with neither, phone sharing is off. Never rotate it once numbers are stored.
PHONE_KEY=
# Optional key for the opaque ids companies see in Find people (pending item 19). Without it NAME_HASH_KEY is used
# (never CRON_SECRET); in production with neither, Find people is off. Rotating it only changes those ids.
FIND_REF_KEY=

# The app's own email (work-email codes for company sign-up, joining, the re-check and the current-job check), through
# Resend (dev/email-sender-steps.md, step 6). Optional locally, where codes show on screen. In production, with
# NAME_HASH_KEY, these turn the codes on; without them they stay off ("opens soon"). Sign-in codes go through Supabase.
RESEND_API_KEY=
EMAIL_FROM="CareerMetro <no-reply@careermetro.com>"

# Optional: total model spend per UTC day before uploads pause. Defaults to 5 (US dollars).
PARSE_DAILY_BUDGET_USD=5
# Optional: mock interview feedback spend per UTC day, across everyone, before rounds end without feedback. Defaults to 3.
# MOCK_DAILY_BUDGET_USD=

# Supabase Auth (sign-in). Public by design: the anon/publishable key, never the service_role key.
# Leave empty and previews and local dev offer a "Continue as test user" sign-in instead (needs DATABASE_URL).
# Set both in Vercel's Production and Preview scopes so previews switch to the real sign-in too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Continue with Google" shows only with GOOGLE_SIGNIN=1, once the Google provider is on in Supabase
# (docs/plans/signin-setup-steps.md). Without it, sign-in is by emailed code alone.
GOOGLE_SIGNIN=

# Who may open the company review page /admin/companies: sign-in emails, comma-separated, any case. Set it only in
# Vercel, never in the repository. Unset in production means nobody. Unset locally or on a preview with the test
# sign-in, the test user admin@careermetro.test is the admin (docs/local-setup.md).
ADMIN_EMAILS=
